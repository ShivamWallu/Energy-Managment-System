# ==============================================================================
# Mashal EMS Intelligence — Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in the required credentials.
# Do NOT place actual passwords or secret keys in this template.
# ==============================================================================

PROJECT_NAME="Mashal EMS Intelligence — Energy Management System"
VERSION="1.0.0"

# Application Security Secret Key (Generate a random 32+ char string in production)
SECRET_KEY=your_secret_key_here

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./ems_data.db
# Required only when creating the first admin account. Generate a unique secret and keep it out of source control.
ADMIN_INITIAL_PASSWORD=replace_with_a_unique_random_password

# ------------------------------------------------------------------------------
# Dual-Account Corporate SMTP Configuration
# ------------------------------------------------------------------------------
# Primary Account (Default sender for OTP and system notifications)
PRIMARY_SMTP_USER=noreplykogm@gmail.com
PRIMARY_SMTP_PASSWORD=your_primary_gmail_app_password

# Secondary Account (Automatic failover when primary reaches quota)
SECONDARY_SMTP_USER=chd.kogm@gmail.com
SECONDARY_SMTP_PASSWORD=your_secondary_gmail_app_password

# SMTP Server Parameters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

