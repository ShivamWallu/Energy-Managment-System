[Unit]
Description=EMS Intelligence — Production FastAPI Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/ems
EnvironmentFile=/var/www/ems/.env
ExecStart=/var/www/ems/venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8004 --workers 2 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
