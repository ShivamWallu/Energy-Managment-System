# ==============================================================================
# EMS Intelligence — Production Environment Configuration
# ==============================================================================

PROJECT_NAME="EMS Intelligence — Energy Management System"
VERSION="1.0.0"

# Application Security
# Generate a strong 64-character secret using: openssl rand -hex 32
SECRET_KEY="replace_with_a_cryptographically_secure_random_key_64_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720 # 12 hours (matches one full shift)

# Database Configuration
# In production, use PostgreSQL on AWS RDS or local EC2 PostgreSQL instance:
DATABASE_URL="postgresql://ems_user:StrongSecurePassword2026!@localhost:5432/ems_intelligence"

# For lightweight staging/local running, SQLite is also supported:
# DATABASE_URL="sqlite:///./ems_data.db"

# Storage & File Limits
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 Megabytes
